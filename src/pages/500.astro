---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout title="Something went wrong | Font Finder Tool" description="An unexpected error occurred." noindex>
  <ErrorState
    code="500"
    title="Something went wrong"
    message="An unexpected error stopped this page from loading. Try again in a moment, or head back to the font finder."
  >
    <button type="button" class="btn-pill btn-primary" data-reload>Try again</button>
    <a href="/" class="btn-pill btn-ghost">Go home</a>
  </ErrorState>
</Layout>

<script>
  document.querySelector('[data-reload]')?.addEventListener('click', () => location.reload());
</script>
