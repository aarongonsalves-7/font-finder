---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
import { getLangFromUrl, useContent, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { serverError } = useContent(lang).errors;
---

<Layout title={serverError.title} description={serverError.description} noindex>
  <ErrorState code="500" title={serverError.heading} message={serverError.message}>
    <button type="button" class="btn-pill btn-primary" data-reload>{serverError.primary}</button>
    <a href={useTranslatedPath(lang)('/')} class="btn-pill btn-ghost">{serverError.secondary}</a>
  </ErrorState>
</Layout>

<script>
  document.querySelector('[data-reload]')?.addEventListener('click', () => location.reload());
</script>
