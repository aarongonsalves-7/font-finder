---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
import { getLangFromUrl, useContent, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { notFound } = useContent(lang).errors;
const translatePath = useTranslatedPath(lang);
---

<Layout title={notFound.title} description={notFound.description} noindex>
  <ErrorState code="404" title={notFound.heading} message={notFound.message}>
    <a href={translatePath('/')} class="btn-pill btn-primary">{notFound.primary}</a>
    <a href={translatePath('/contact')} class="btn-pill btn-ghost">{notFound.secondary}</a>
  </ErrorState>
</Layout>
