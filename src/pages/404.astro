---
import Layout from '../layouts/Layout.astro';
import ErrorState from '../components/ErrorState.astro';
---

<Layout title="Page not found | Font Finder Tool" description="This page doesn't exist." noindex>
  <ErrorState
    code="404"
    title="This page is missing"
    message="The page you’re looking for doesn’t exist. Maybe the font you’re after does, though."
  >
    <a href="/" class="btn-pill btn-primary">Find a font</a>
    <a href="/contact" class="btn-pill btn-ghost">Report a broken link</a>
  </ErrorState>
</Layout>
