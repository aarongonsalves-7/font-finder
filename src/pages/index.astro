---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Comparison from '../components/Comparison.astro';
import Faq from '../components/Faq.astro';
import FontFinderGuide from '../components/FontFinderGuide.astro';
import { homeFaq } from '../data/faq';
import { faqSchema, organizationSchema, webAppSchema, websiteSchema } from '../lib/schema';
---

<Layout
  title="Font Finder | Free AI Font Finder by Image | Font Finder Tool"
  description="Free font finder: upload an image to identify any font in seconds. AI font finder matching 1,900+ free Google Fonts, previewed in your text. No sign up."
  schema={[websiteSchema(), organizationSchema(), webAppSchema(), faqSchema(homeFaq)]}
>
  <PageHero
    eyebrow="Free AI font finder"
    title="Font Finder: Spotted a font you love? Find it in seconds."
    description="Upload a screenshot, logo or photo and our font finder compares the lettering with 1,900+ free Google Fonts, right in your browser, with no sign up and no limits."
  />
  <HowItWorks />
  <FeatureGrid />
  <Comparison />
  <FontFinderGuide />
  <Faq items={homeFaq} />
</Layout>
