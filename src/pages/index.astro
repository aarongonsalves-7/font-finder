---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Comparison from '../components/Comparison.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { homeFaq } from '../data/faq';
import { faqSchema, webAppSchema } from '../lib/schema';
---

<Layout
  title="Font Finder Tool — Identify Fonts from Any Image, Free"
  description="Upload or paste an image to identify the font. Get the closest free Google Fonts, previewed in your own text, with free alternatives to popular paid fonts."
  schema={[webAppSchema(), faqSchema(homeFaq)]}
>
  <PageHero
    eyebrow="Free font finder"
    title="Find any font from an image"
    description="Upload a screenshot, logo or photo. We compare the lettering with 1,900+ free Google Fonts — right in your browser, with no sign-up and no limits."
  />
  <HowItWorks />
  <FeatureGrid />
  <Comparison />
  <Faq items={homeFaq} />
  <CtaBand />
</Layout>
