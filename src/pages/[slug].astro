---
import HomeView from '../components/views/HomeView.astro';
import SlugView from '../components/views/SlugView.astro';
import { defaultLang } from '../i18n/ui';
import { isLang } from '../i18n/utils';
import { isLandingSlug, isProseSlug } from '../i18n/routes';

// Rendered on demand. One path segment is either a language home ("/es") or an English page
// ("/about", "/logo-font-finder"); anything else falls through to 404.astro.
const { slug } = Astro.params;
if (slug === defaultLang) return Astro.redirect('/', 301);
const isHome = isLang(slug);
if (!isHome && !isLandingSlug(slug) && !isProseSlug(slug)) {
  return new Response(null, { status: 404 });
}
---

{isHome ? <HomeView /> : <SlugView slug={slug as never} />}
