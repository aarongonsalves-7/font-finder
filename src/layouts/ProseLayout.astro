---
import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  updated?: string;
  noindex?: boolean;
}

const { title, description, heading, updated, noindex } = Astro.props;
---

<Layout title={title} description={description} noindex={noindex}>
  <article class="container-page max-w-3xl py-16 sm:py-24">
    <h1 class="text-[2rem] leading-tight font-semibold tracking-[-0.04em] sm:text-display">{heading}</h1>
    {updated && <p class="eyebrow mt-4">Last updated {updated}</p>}
    <div class="rich-text mt-10">
      <slot />
    </div>
  </article>
</Layout>
