---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/ThemeScript.astro';
import { defaultLang, ogLocales } from '../i18n/ui';
import { alternates, getLangFromUrl, useTranslatedPath, useTranslations } from '../i18n/utils';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Structured data objects rendered as JSON-LD. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
  /** Alt text for the social share image. */
  ogImageAlt?: string;
  /**
   * Language-neutral path of this page ("/", "/about"). Indexable pages pass it so the canonical
   * URL and hreflang links point at every language version.
   */
  path?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, schema = [], noindex = false, ogImageAlt = t('site.ogImageAlt'), path } = Astro.props;
const canonical = new URL(path === undefined ? Astro.url.pathname : useTranslatedPath(lang)(path), Astro.site);
const hreflangs = path === undefined || noindex ? [] : alternates(path, Astro.site!);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    {hreflangs.length > 0 && <link rel="alternate" hreflang="x-default" href={hreflangs.find((alt) => alt.lang === defaultLang)!.href} />}
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="FontFinder" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#fafafa" />
    <meta name="application-name" content="Font Finder Tool" />
    <meta name="author" content="Font Finder Tool" />
    <ThemeScript />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Font Finder Tool" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocales[lang]} />
    {hreflangs.filter((alt) => alt.lang !== lang).map((alt) => <meta property="og:locale:alternate" content={ogLocales[alt.lang]} />)}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Font cssVariable="--font-geist" preload />
    <Font cssVariable="--font-geist-mono" />


    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\u003c')} />)}
  </head>
  <body class="flex min-h-dvh flex-col font-sans">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 btn-square btn-primary">
      {t('site.skip')}
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
