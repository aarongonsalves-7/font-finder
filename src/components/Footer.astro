---
import Logo from './Logo.astro';
import ThemePicker from './ThemePicker.astro';
import { footerNav } from '../data/nav';
import { languages } from '../i18n/ui';
import { getLangFromUrl, langs, stripLang, useTranslatedPath, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const path = stripLang(Astro.url.pathname);

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-hairline bg-canvas">
  <div class="container-page grid gap-10 py-16 sm:grid-cols-2 lg:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div class="max-w-xs">
      <Logo />
      <p class="mt-4 text-sm leading-6 text-body">
        {t('site.tagline')}
      </p>
      <div class="mt-6"><ThemePicker /></div>
    </div>

    {footerNav.map((group) => (
      <nav aria-label={t(group.title)}>
        <h2 class="eyebrow">{t(group.title)}</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {group.links.map((link) => (
            <li><a href={translatePath(link.href)} class="text-body hover:text-ink">{t(link.label)}</a></li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <nav lang="en" aria-label="Additional policies" class="container-page flex flex-wrap gap-4 py-4 text-sm"><a href="/cookies" class="underline">Cookie policy</a><a href="/refunds" class="underline">Refund policy</a></nav>
  <nav aria-label={t('lang.label')} class="border-t border-hairline">
    <ul class="container-page flex flex-wrap gap-x-4 gap-y-2 py-5 text-xs">
      {langs.map((l) => (
        <li>
          <a
            href={translatePath(['/cookies', '/refunds'].includes(path) ? '/' : path, l)}
            hreflang={l}
            lang={l}
            aria-current={l === lang ? 'true' : undefined}
            class="text-mute hover:text-ink aria-[current]:font-medium aria-[current]:text-ink"
          >
            {languages[l]}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="border-t border-hairline">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-mute sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} Font Finder Tool · fontfindertool.com</p>
      <p>
        {t('footer.fontsFrom')}{' '}
        <a href="https://fonts.google.com" rel="noopener" class="underline-offset-2 hover:text-ink hover:underline">Google Fonts</a>{' '}
        {t('footer.via')}{' '}
        <a href="https://fontsource.org" rel="noopener" class="underline-offset-2 hover:text-ink hover:underline">Fontsource</a>.
      </p>
    </div>
  </div>
</footer>
