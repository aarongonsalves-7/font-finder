---
// Footer control: System / Light / Dark.
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const t = useTranslations(getLangFromUrl(Astro.url));
const options = [
  { value: 'system', label: t('theme.system') },
  { value: 'light', label: t('theme.light') },
  { value: 'dark', label: t('theme.dark') }
];
---

<div role="radiogroup" aria-label={t('theme.label')} data-theme-picker class="inline-flex rounded-pill border border-hairline bg-elevated p-0.5">
  {options.map((o) => (
    <button
      type="button"
      role="radio"
      aria-checked="false"
      data-theme-option={o.value}
      class="rounded-pill px-2.5 py-1 text-xs text-mute transition-colors hover:text-ink aria-checked:bg-hairline-soft aria-checked:text-ink"
    >
      {o.label}
    </button>
  ))}
</div>

<script>
  import { getThemePref, setThemePref, THEME_EVENT, type ThemePref } from '../scripts/theme';

  const options = document.querySelectorAll<HTMLButtonElement>('[data-theme-option]');
  const sync = () => {
    const pref = getThemePref();
    for (const o of options) o.setAttribute('aria-checked', String(o.dataset.themeOption === pref));
  };
  for (const o of options) o.addEventListener('click', () => setThemePref(o.dataset.themeOption as ThemePref));
  document.addEventListener(THEME_EVENT, sync);
  sync();
</script>
