---
import SectionHeading from './SectionHeading.astro';
import { getLangFromUrl, useContent } from '../i18n/utils';

const { features: copy } = useContent(getLangFromUrl(Astro.url));
const demos = ['filter', 'preview', 'alts', 'license', 'crop', 'private'];
const features = copy.items.map((item, i) => ({ ...item, demo: demos[i] }));
---

<section class="container-page py-20 sm:py-24" aria-labelledby="features-title">
  <SectionHeading
    id="features-title"
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
  />

  <ul class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((f) => (
      <li class="card flex flex-col p-6 shadow-whisper">
        <div class="mb-6 flex h-24 items-center justify-center rounded-sm border border-hairline-soft bg-canvas" aria-hidden="true">
          {f.demo === 'filter' && (
            <span class="inline-flex rounded-pill border border-hairline bg-elevated p-1 text-xs font-medium">
              <span class="rounded-pill px-3 py-1 text-body">{copy.demo.all}</span>
              <span class="rounded-pill bg-ink px-3 py-1 text-on-ink">{copy.demo.serif}</span>
              <span class="rounded-pill px-3 py-1 text-body">{copy.demo.script}</span>
            </span>
          )}
          {f.demo === 'preview' && <span class="font-serif text-3xl tracking-tight text-ink italic" lang="en">{copy.demo.preview}</span>}
          {f.demo === 'alts' && (
            <span class="flex flex-wrap justify-center gap-1.5 text-xs">
              <span class="rounded-pill border border-hairline bg-elevated px-2.5 py-1 text-ink">Montserrat</span>
              <span class="text-mute">≈</span>
              <span class="rounded-pill bg-warning-soft px-2.5 py-1 font-medium text-warning-deep">Gotham</span>
            </span>
          )}
          {f.demo === 'license' && (
            <span class="flex gap-1.5 text-xs font-medium">
              <span class="rounded-pill bg-link-soft px-2.5 py-1 text-link-deep">{copy.demo.license}</span>
            </span>
          )}
          {f.demo === 'crop' && (
            <span class="relative px-3 py-1 font-mono text-lg text-ink">
              <span class="absolute inset-0 border-2 border-link bg-link/10"></span>
              Aa Bb Cc
            </span>
          )}
          {f.demo === 'private' && (
            <svg class="size-8 text-ink" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="5" y="10.5" width="14" height="10" rx="2" /><path d="M8.5 10.5V7.5a3.5 3.5 0 0 1 7 0v3" />
            </svg>
          )}
        </div>
        <h3 class="text-heading-md">{f.title}</h3>
        <p class="mt-2 text-sm leading-6 text-body">{f.body}</p>
      </li>
    ))}
  </ul>
</section>
