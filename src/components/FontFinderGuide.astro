---
import SectionHeading from './SectionHeading.astro';
import { getLangFromUrl, localizeHtml, useContent } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const { guide } = useContent(lang);
---

<section id="guide" class="container-page scroll-mt-24 py-20 sm:py-24" aria-labelledby="guide-title">
  <SectionHeading
    id="guide-title"
    eyebrow={guide.eyebrow}
    title={guide.title}
    description={guide.description}
  />

  <div class="rich-text mt-10 max-w-3xl" set:html={localizeHtml(guide.html, lang)} />
</section>
