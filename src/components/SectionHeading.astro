---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  id?: string;
}

const { eyebrow, title, description, id } = Astro.props;
---

<div class="max-w-2xl">
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-[1.75rem] leading-tight font-semibold tracking-[-0.04em] sm:text-heading-lg">{title}</h2>
  {description && <p class="mt-3 text-base leading-7 text-body">{description}</p>}
</div>
