---
interface Props {
  title?: string;
}

const { title = 'Spotted a font you love? Find it in seconds.' } = Astro.props;
---

<section class="container-page">
  <div class="card px-6 py-16 text-center sm:py-24">
    <h2 class="mx-auto max-w-2xl text-[1.75rem] leading-tight font-semibold tracking-[-0.04em] sm:text-display">{title}</h2>
    <p class="mx-auto mt-4 max-w-md text-base text-body">Free to use. No sign-up. Free and paid matches with a one-tap filter.</p>
    <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="#detector" class="btn-pill btn-primary">Upload an image</a>
      <a href="/free-font-finder" class="btn-pill btn-ghost">Find free fonts only</a>
    </div>
  </div>
</section>
